{
	"version": "0.2.0",
	"configurations": [
		{
			// Запускает адаптер в TCP-режиме (флаг debug) — к нему можно подключаться DAP-клиентом.
			"name": "Запустить адаптер (TCP-режим)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "Собрать адаптер",
			"program": "${workspaceFolder}/bin/Debug/net8.0/OnecDebugAdapter.dll",
			"args": ["--debug", "true"],
			"cwd": "${workspaceFolder}",
			"console": "internalConsole",
			"stopAtEntry": false
		},
		{
			// Основной сценарий: расширение запускает адаптер само (настройка adapterFile),
			// сюда подключаемся к уже работающему процессу dotnet.
			"name": "Подключиться к процессу адаптера",
			"type": "coreclr",
			"request": "attach"
		}
	]
}
